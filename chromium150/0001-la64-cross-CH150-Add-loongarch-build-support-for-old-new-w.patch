+
+  context->pc = value++;
+
+  for (size_t index = 0; index < std::size(context->fpregs); ++index) {
+    context->fpregs[index] = static_cast<double>(value++);
+  }
+
+  context->fcsr = value++;
+  context->fcc = value++;
