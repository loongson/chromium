--- /dev/null
+++ b/build/cross-build.sh
@@ -0,0 +1,82 @@
+#! /bin/bash
+
+# LBrowser V3 build configuration description.
+# Author: Wang Qing <wangqing-hf@loongson.cn>
+
+# Set target_cpu, la64 on default.
+UNAME=$1
+if [[ $UNAME == la64 ]]; then
+  target_cpu=loong64
+elif [[ $UNAME == loongarch64 ]]; then
+  target_cpu=loongarch64
+elif [[ $UNAME == "" ]]; then
+  target_cpu=loong64
+else
+  echo -e "\e[31m Error:\e[0m Unspport target CPU!!!"
+  exit 1
+fi
+
+root_build_dir="out/la64_cross"
+
+if [ $target_cpu == loong64 ]; then
+export GN_CONFIG=(
+'enable_swiftshader=true'
+'enable_widevine=false'
+'fatal_linker_warnings=false'
+'disable_fieldtrial_testing_config=true'
+'ffmpeg_branding="Chrome"'
+'proprietary_codecs=true'
+'is_debug=false'
+'is_clang=true'
+'is_official_build=true'
+'use_thin_lto=false'
+'chrome_pgo_phase=0'
+'clang_use_chrome_plugins=false'
+'link_pulseaudio=true'
+'symbol_level=0'
+'use_qt6=false'
+'use_qt5=false'
+'treat_warnings_as_errors=false'
+'use_pulseaudio=true'
+'use_sysroot=true'
+'host_cpu = "x64"'
+'target_cpu = "loong64"'
+'v8_target_cpu = "loong64"'
+'rust_bindgen_root="/opt/rust-1.92.0-nightly-cross"'
+'rust_sysroot_absolute="/opt/rust-1.92.0-nightly-cross"'
+'rustc_version="1.92.0-nightly"')
+
+root_build_dir="out/la64_cross"
+
+elif [ $target_cpu == loongarch64 ]; then
+export GN_CONFIG=(
+'enable_swiftshader=true'
+'enable_widevine=false'
+'fatal_linker_warnings=false'
+'disable_fieldtrial_testing_config=true'
+'ffmpeg_branding="Chrome"'
+'proprietary_codecs=true'
+'is_debug=false'
+'is_clang=true'
+'is_official_build=true'
+'use_thin_lto=false'
+'chrome_pgo_phase=0'
+'clang_use_chrome_plugins=false'
+'link_pulseaudio=true'
+'symbol_level=0'
+'treat_warnings_as_errors=false'
+'use_pulseaudio=true'
+'use_sysroot=true'
+'host_cpu = "x64"'
+'target_cpu = "loong64"'
+'v8_target_cpu = "loong64"'
+'loongarch64_use_lsx=true'
+'loongarch64_use_lasx=true'
+'use_nw=true')
+
+root_build_dir="out/la64_cross-new"
+
+fi
+
+# generate root_build_dir to build.
+./buildtools/linux64/gn gen $root_build_dir --args="${GN_CONFIG[*]}"
